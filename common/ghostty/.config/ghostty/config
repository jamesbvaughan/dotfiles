# docs: https://ghostty.org/docs/config/reference

# Reload the config with Cmd+Shift+,

theme = dark:Kanagawa Dragon,light:Kanagawa Lotus

# Fonts

## Berkeley Mono
font-family            = Berkeley Mono Variable
font-style             = Retina Condensed
font-style-italic      = Retina Condensed Oblique
font-style-bold        = Bold Condensed
font-style-bold-italic = Bold Condensed Oblique

## Greybeard
# font-family = Greybeard 16px

## Pixel Code
# font-family = Pixel Code

# Custom icon styling
macos-icon              = custom-style
macos-icon-frame        = plastic
macos-icon-ghost-color  = c5c9c5
macos-icon-screen-color = 181616

# Hide the macOS title bar
# window-decoration = false

# Transparency
# background-opacity       = 0.85
# background-opacity-cells = true
# background-blur          = macos-glass-regular

# Shaders
# custom-shader = /Users/james/.config/ghostty/crt-shader-with-chromatic-aberration-glow-scanlines-dot-matrix.glsl
