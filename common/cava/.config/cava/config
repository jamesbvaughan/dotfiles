## Configuration file for CAVA (Console-based Audio Visualizer)
## Managed by GNU Stow in ~/.dotfiles/common/cava/.config/cava/config

[general]
# Live config reloading
live-config = 1

# Framerate (60 fps for smooth rendering)
framerate = 120

# Sensitivity control
autosens = 1
sensitivity = 100

# Bar configuration (0 = auto-fill terminal)
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 100

# Frequency cutoffs (Hz)
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

# Seconds with no input before going to sleep mode (0 = disabled)
sleep_timer = 0


[input]
# Audio capturing method (pipewire/pulse/alsa/auto)
method = pipewire
source = auto


[output]
method = noncurses
orientation = bottom

# Channels: stereo (mirrored low-to-high from center) or mono
channels = mono

# Enables synchronized render to prevent tearing in modern terminals (Ghostty/Alacritty)
synchronized_sync = 1

# Show flat base bar when audio is silent
show_idle_bar_heads = 1


