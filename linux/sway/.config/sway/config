# Set up the XDG environment.
exec dbus-update-activation-environment --systemd \
  DISPLAY \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP=sway \
  XDG_SESSION_TYPE=wayland

# Activate graphical-session.target so user services enabled against it (vicinae,
# etc.) actually start at login.
exec systemctl --user start sway-session.target

# Ask for dark mode.
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'

# enable an authentication agent
# https://wiki.archlinux.org/title/Polkit#Authentication_agents
exec /usr/lib/hyprpolkitagent/hyprpolkitagent

# 1Password
exec 1password --silent

# Dropbox
exec dropbox

# syncthing
# exec syncthingtray --wait

# tailscale tray icon
# exec tailscale-systray

# use wob as an indicator bar
set $WOBSOCK $XDG_RUNTIME_DIR/wob.sock
exec rm -f $WOBSOCK && mkfifo $WOBSOCK && tail -f $WOBSOCK | wob

set $lock_cmd 'pidof hyprlock || hyprlock --grace 10'

# set up a lock screen
exec swayidle -w \
	timeout 1800 $lock_cmd \
	timeout 1805 'swaymsg "output * dpms off"' \
	resume 'swaymsg "output * dpms on"' \
  before-sleep 'playerctl pause' \
  before-sleep 'pidof hyprlock || hyprlock --grace 10'


### Colors

# kanagawa dragon
set $green  '#87a987'
set $red    '#c4746e'
set $black  '#181616'
set $blue   '#8ba4b0'
set $orange '#b6927b'

# class          border backgr. text indicator child_border
client.focused   $red   $red    $red $blue     $orange
client.unfocused $red   $red    $red $red      $black


### Variables

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term ghostty
set $menu vicinae toggle


### Wallpaper

# output "*" bg /home/james/code/wallpapers/gruvbox/houseonthesideofalake.jpg fill
# output "*" bg #181616 solid_color
output "*" bg #080606 solid_color


### Window configuration

default_border pixel 2
# hide_edge_borders vertical
gaps inner 10
smart_borders on
smart_gaps on

for_window [app_id="Zoom"] floating enable
for_window [app_id="^bluetui\.Bluetui$"] floating enable, resize set 900 700
# for_window [app_id="blueman-manager"] floating enable
# for_window [app_id="pavucontrol"] floating enable
# for_window [app_id="syncthingtray"] floating enable, border none, resize set 450 400, move position 3300 0


### HiDPI

# Laptop built-in display
output eDP-1 scale 1.6
# External display (often an Apple Studio Display)
output DP-1 scale 2

# The Apple Studio Display shows two devides, and this one is never visible.
# Explicitly disable it to avoid confusion.
output DP-2 disable


### Lid switch

# Turn the built-in display off when the lid closes.
# --reload reapplies this on config reload, so starting or reloading sway with
# the lid shut keeps eDP-1 off.
bindswitch --reload --locked lid:on  output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable


### Font

font pango:Berkeley Mono 10px


### Input configuration (man sway-input)

input type:touchpad {
  dwt enabled
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
  pointer_accel 1
  accel_profile flat
  scroll_factor 0.1
  click_method clickfinger
}

input type:keyboard {
  repeat_delay 200
  repeat_rate 40
  xkb_options caps:ctrl_modifier
}


### Key bindings

bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+space exec $menu
bindsym $mod+Shift+c reload
bindsym $mod+Shift+q exit

bindsym $mod+n exec swaync-client --toggle-panel

floating_modifier $mod normal
bindsym $mod+t floating toggle

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+tab workspace next
bindsym $mod+Shift+tab workspace prev

bindgesture swipe:left workspace next
bindgesture swipe:right workspace prev

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+bar   splith
bindsym $mod+minus splitv

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+f fullscreen

# bindsym $mod+Shift+space layout toggle splitv splith

# bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent
bindsym $mod+z focus child

set $screenshot_file ~/screenshots/screenshot-at-$(date +"%Y-%m-%d-%H-%M-%S").png
bindsym $mod+Control+4 exec grimshot --notify save area $screenshot_file
bindsym $mod+Control+5 exec grimshot --notify save output $screenshot_file

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1| awk '{print substr($5, 1, length($5)-1)}' > $WOBSOCK
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > $WOBSOCK

bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

bindsym XF86Display exec $lock_cmd

# Targets the laptop panel with the lid open, the external when docked.
bindsym XF86MonBrightnessDown exec ~/.dotfiles/scripts/brightness.sh down > $WOBSOCK
bindsym XF86MonBrightnessUp exec ~/.dotfiles/scripts/brightness.sh up > $WOBSOCK

bindsym $mod+p exec ~/pw


#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt

    # return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bar {
  swaybar_command waybar
}
