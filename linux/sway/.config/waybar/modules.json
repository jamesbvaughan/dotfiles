{
  "ext/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    }
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    }
  },
  "hyprland/submap": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "hyprland/window": {
    "max-length": 80
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%Y-%m-%d}"
  },
  "custom/events": {
    "format": "{}",
    "max-length": 100,
    "tooltip": true,
    "interval": 300,
    "format-icons": {
      "default": ""
    },
    "exec": "$HOME/.config/waybar/scripts/khal.py",
    "return-type": "json"
  },
  "cpu": {
    "format": "{usage}% "
  },
  "memory": {
    "format": "{}% "
  },
  "temperature": {},
  // Not waybar's built-in "backlight" module: that one only reads
  // /sys/class/backlight, where the Studio Display never appears. This follows
  // whichever display is active, same as the XF86MonBrightness bindings.
  "custom/brightness": {
    "format": "{}% {icon}",
    "format-icons": [
      "",
      ""
    ],
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/brightness.sh",
    // Only a backstop for changes made on the display itself; brightness.sh
    // signals us directly whenever it changes something.
    "interval": 30,
    "signal": 1,
    "tooltip": false,
    "on-scroll-up": "$HOME/.dotfiles/scripts/brightness.sh up",
    "on-scroll-down": "$HOME/.dotfiles/scripts/brightness.sh down"
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ]
  },
  "network#wifi": {
    "interface": "w*",
    "format-wifi": "{essid} ({signalStrength}%) {ipaddr} ",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "network#ethernet": {
    "interface": "en*",
    "format-wifi": "",
    "format-ethernet": "{ifname}: {ipaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "bluetooth": {},
  "custom/spotify": {
    "format": "{} ",
    "escape": true,
    "max-length": 60,
    "interval": 5,
    "on-click": "spt playback --toggle",
    "on-click-right": "wezterm -e spt",
    "exec": "spt playback"
  },
  "tray": {
    "icon-size": 24,
    "spacing": 4
  },
  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 300,
    "exec": "$HOME/.config/waybar/scripts/wttr.py",
    "return-type": "json"
  },
  "custom/wattage": {
    "format": " {} 󱐋",
    "interval": 5,
    "exec": "$HOME/.config/waybar/scripts/wattage.sh"
  },
  "custom/blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/separator": {
    "format": "|",
    "interval": "once",
    "tooltip": false
  },
  "custom/lock": {
    "format": "",
    "interval": "once",
    "tooltip": false,
    "on-click": "hyprlock --grace 0"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "systemd-failed-units": {
    "hide-on-ok": false,
    "format": " ✗ {nr_failed} ",
    "format-ok": " ✓ ",
    "system": true,
    "user": true,
    "tooltip-format": "{nr_failed} failed units:n{failed_units_list}",
    "tooltip-unit-format": "{scope}: {name} ({active_state})"
  }
}
// vim: ft=jsonc
